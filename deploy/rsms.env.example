FLASK_ENV=production
SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql+psycopg://rsms:CHANGE_ME@127.0.0.1:5432/rsms
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info
MAX_CONTENT_LENGTH=16777216
