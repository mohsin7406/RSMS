# Required in production
FLASK_ENV=production
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://rsms:change-me@127.0.0.1:5432/rsms
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RSMS_UPDATE_KEY=replace-with-a-separate-long-random-update-signing-key

# Reverse proxy / HTTPS
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true

# Upload and Gunicorn tuning
MAX_CONTENT_LENGTH=33554432
GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Optional fixed server-side restart command. It is never supplied by an update package.
# Example with a user-level systemd service:
# RSMS_RESTART_COMMAND=systemctl --user restart rsms

# Only for the one-time admin bootstrap command
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password

# Never enable this in production
ALLOW_DEMO_SEED=false
